@page
@inject IHttpContextAccessor HttpContextAccessor
@using Microsoft.AspNetCore.Authentication
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="display-5">👋 Welcome</h1>
        <p class="lead">
            Learn about <a href="https://learn.microsoft.com/aspnet/core" target="_blank">building Web apps with ASP.NET Core</a>.
        </p>
    </div>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">🔐 User Claims</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Claim Type</th>
                            <th scope="col">Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in User.Claims)
                        {
                            <tr>
                                <td class="text-muted">@claim.Type</td>
                                <td>@claim.Value</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning mt-4" role="alert">
            ⚠️ You are not authenticated. Please <a href="/login">login</a> to see your claims.
        </div>
    }

    @{
        var accessToken = await HttpContextAccessor.HttpContext.GetTokenAsync("access_token");
        var idToken = await HttpContextAccessor.HttpContext.GetTokenAsync("id_token");
        var refreshToken = await HttpContextAccessor.HttpContext.GetTokenAsync("refresh_token");
    }

    <h5>Tokens</h5>
    <ul>
        <li><strong>Access Token:</strong> @accessToken</li>
        <li><strong>ID Token:</strong> @idToken</li>
        <li><strong>Refresh Token:</strong> @refreshToken</li>
    </ul>

</div>
